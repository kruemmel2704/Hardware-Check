<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;artifacts/**;.obj_legacy/**;.bin_legacy/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="PdfSharp" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Eingebettete Schrift für die PDF-Berichte (PdfSharp hat keine eigenen Schriften) -->
    <EmbeddedResource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL-Carlito.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
